{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Master",
  "version": "0.4.0",
  "identifier": "com.master.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Project Master — BETA v0.4.0 RC",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765 ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "Master Mike",
    "homepage": "https://github.com/RealMasterMike/Project-Master",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Local-first multi-AI command center",
    "longDescription": "Project Master is a local-first desktop command center for orchestrating AI models, tools, evidence, creative workflows, and user-approved automation.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/project-master-backend"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {}
      },
      "rpm": {
        "release": "1",
        "epoch": 0,
        "files": {},
        "compression": {
          "type": "zstd",
          "level": 10
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGNjkwMTgyNzA1REE2OTYKUldTV3BsMXdnZ0ZwVHpWVy9iNVF1Y042OWJqejc3NlNxazNLSWRSbUYyMWVRUHhpbHRtVjFEbmMK",
      "endpoints": [
        "https://github.com/RealMasterMike/Project-Master/releases/download/updater-beta/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
